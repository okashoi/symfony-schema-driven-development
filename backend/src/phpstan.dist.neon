parameters:
    level: max
    paths:
        - bin/
        - config/
        - lib/
        - public/
        - src/
        - tests/
    ignoreErrors:
        -
            identifier: function.alreadyNarrowedType
            count: 1
            path: tests/bootstrap.php
        -
            identifier: argument.type
            count: 1
            path: public/index.php
